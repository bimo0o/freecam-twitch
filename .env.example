# npm run setup creates random local secrets. Never commit .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOCAL_CHANNEL_ID=1
LOCAL_ADMIN_SECRET=
PUBLISH_MASTER_SECRET=
MEDIA_AUTH_SECRET=
# Base64 secret from Twitch Developer Console; server only
TWITCH_EXTENSION_SECRET=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MEDIA_INTERNAL_URL=http://127.0.0.1:8888
# Build-time public URL; leave empty for same-origin local viewer
VITE_API_BASE=
# Production only: DNS and public ICE IP
APP_DOMAIN=freecam.example.com
INGEST_DOMAIN=ingest.example.com
PUBLIC_IP=127.0.0.1
