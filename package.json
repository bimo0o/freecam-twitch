{
  "name": "freecam-twitch",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test tests/*.test.ts",
    "setup": "node scripts/setup.mjs",
    "start": "tsx server/index.ts",
    "demo:sync": "node scripts/generate-sync-bench.mjs && node scripts/generate-packed-demo.mjs --gif docs/assets/sync-camera.gif --reference --output .tools/packed-sync.mp4",
    "test:packed": "playwright test tests/packed.spec.ts",
    "test:extension": "node scripts/test-packed-extension.mjs"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "hls.js": "^1.7.4",
    "jose": "^6.2.15",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "node": "^22.23.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
